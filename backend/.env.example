OPENAI_API_KEY=*
OPENALEX_API_KEY=*
# Optional alternate extractor; local PyMuPDF indexing needs no service.
# PDFs are sent here only for explicitly selected GROBID jobs.
GROBID_URL=
SUPABASE_URL=*
SUPABASE_KEY=*

# Supabase remains the database. Choose where newly uploaded paper PDFs go.
PAPER_STORAGE_PROVIDER=supabase
# Required for GCS; authenticate locally with gcloud auth application-default login.
GCS_PROJECT_ID=
GCS_PDF_BUCKET=
